{
  "name": "orchestrateur",
  "version": "0.1.1",
  "description": "Navigateur multi-fournisseurs a isolation de session pour usage judiciaire",
  "author": "SaideIsmael",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "lint": "eslint \"src/main/**/*.{ts,tsx}\" \"src/renderer/**/*.{ts,tsx}\" \"src/shared/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"tests-e2e/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test -c tests-e2e/playwright.config.ts",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "execa": "^9.6.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.21.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.1.0",
    "eslint": "^9.16.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.4",
    "vitest": "^4.0.18"
  },
  "build": {
    "appId": "com.orchestrateur.app",
    "productName": "Orchestrateur",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "config/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "forceCodeSigning": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "SaideIsmael",
        "repo": "orchestrateur",
        "releaseType": "release"
      }
    ]
  }
}
